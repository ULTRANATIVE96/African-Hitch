# ── Limpopo Hitch Connect Frontend Production Environment Variables ───────────

# API Base URL (Leave empty when hosting frontend & backend on the same VPS behind Nginx)
VITE_API_URL=""

# Socket.io Real-Time Location Server URL (Leave empty when using relative socket path behind Nginx)
VITE_SOCKET_URL=""

# MapTiler SDK Key for Interactive Route GIS Vector Maps (Get free key from maptiler.com)
VITE_MAPTILER_KEY="your-maptiler-api-key-here"
