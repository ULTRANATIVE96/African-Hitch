# ── Limpopo Hitch Connect Frontend — Vercel Production Environment Variables ──

# API Base URL — points to the VPS backend (required when frontend is on Vercel, separate origin)
# Example: https://hitchconnect.co.za/api   OR   https://api.hitchconnect.co.za/api
VITE_API_URL="https://hitchconnect.co.za/api"

# Socket.io Real-Time Location Server URL — the VPS backend root (no /api suffix)
VITE_SOCKET_URL="https://hitchconnect.co.za"

# MapTiler SDK Key for Interactive Route GIS Vector Maps (Get free key from maptiler.com)
VITE_MAPTILER_KEY="your-maptiler-api-key-here"

# Google OAuth 2.0 Client ID for Google One-Tap & Popup Sign In (From console.cloud.google.com)
# IMPORTANT: Add your Vercel domain to Authorized JavaScript origins in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=""
