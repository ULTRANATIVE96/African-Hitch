# ── Limpopo Hitch Connect Production Environment Variables ────────────────────
PORT=8080
NODE_ENV=production

# PostgreSQL Database Connection URL (Absolute Hosting / HOSTAFRICA VPS or Cloud Postgres)
DATABASE_URL="postgresql://limpopo_user:StrongPassword123!@localhost:5432/limpopo_hitch?schema=public"

# Production JWT Signing Secrets (Generate long random strings for production)
JWT_SECRET="generate-a-strong-random-secret-key-32-chars-long"
ADMIN_JWT_SECRET="generate-a-different-admin-secret-key-32-chars"

# DAC Platform Administration Credentials
ADMIN_USERNAME="dac_admin"
ADMIN_PASSWORD="ChangeMeToASecurePassword2026!"

# CORS Allowed Origin (Set to your exact production domain or wildcard for development)
CORS_ORIGIN="https://hitchconnect.co.za"
